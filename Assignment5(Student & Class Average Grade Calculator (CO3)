NUM_TESTS = 5

num_students = int(input("Enter the number of students in the class: "))
class_total_average = 0.0

for student_idx in range(1, num_students + 1):
    print(f"\n--- Student {student_idx} ---")
    total_score = 0.0

    for test_idx in range(1, NUM_TESTS + 1):
        score = float(input(f"Enter score for Test {test_idx}: "))
        total_score += score

    student_avg = total_score / NUM_TESTS
    class_total_average += student_avg
    print(f"Average score for Student {student_idx}: {student_avg:.2f}")

if num_students > 0:
    overall_class_avg = class_total_average / num_students
    print(f"\nOverall average score for the class: {overall_class_avg:.2f}")
else:
    print("\nNo students entered.")
